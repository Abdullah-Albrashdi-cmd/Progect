@model IEnumerable<JobPosting>
@{
    var jobs = Model.ToList();
    var label = jobs.Count == 1 ? "job" : "jobs";
}
<p class="text-muted mb-3"><i class="bi bi-list-ul me-1"></i><strong>@jobs.Count</strong> @label found</p>

@if (jobs.Count == 0)
{
    <div class="alert alert-light border text-center py-5">
        <i class="bi bi-search fs-1 d-block mb-2"></i>
        No jobs match your search. Try different keywords or clear the filters.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var job in jobs)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card job-card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge rounded-pill badge-type">@job.Type.GetDisplayName()</span>
                            <small class="text-muted">@job.PostedDate.ToString("dd MMM yyyy")</small>
                        </div>
                        <h3 class="h5 card-title mb-1">
                            <a asp-page="/JobDetails" asp-route-id="@job.Id" class="stretched-link text-decoration-none">@job.Title</a>
                        </h3>
                        <div class="text-muted mb-2"><i class="bi bi-building me-1"></i>@job.Company</div>
                        <div class="mb-2"><i class="bi bi-geo-alt me-1 text-primary"></i>@job.Location</div>
                        <p class="card-text small flex-grow-1">@(job.Description.Length > 110 ? job.Description[..110] + "..." : job.Description)</p>
                        <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2 small">
                            <span class="fw-semibold">@job.GetSalaryRange()</span>
                            <span class="text-muted">Closes @job.Deadline.ToString("dd MMM")</span>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
